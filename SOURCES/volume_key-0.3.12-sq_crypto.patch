+error_from_gpgme (GError **error, gpgme_error_t e)
+{
+    size_t len;
+    char *s;
+
+    s = NULL;
+    len = 100;
+    for (;;)
+    {
+        s = g_realloc (s, len);
+        if (gpgme_strerror_r (e, s, len) == 0)
+            break;
+        len *= 2;
+    }
+    g_set_error (error, LIBVK_ERROR, LIBVK_ERROR_CRYPTO, _("%s: %s"),
+                gpgme_strsource (e), s);
+    g_free (s);
+}
+
