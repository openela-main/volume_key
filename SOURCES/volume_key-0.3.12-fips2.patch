-  PK11_FreeSymKey (secret_key);
+  SECITEM_FreeItem (clear_secret_item, PR_TRUE);
 
   return ret;
 
- err_secret_key:
-  PK11_FreeSymKey (secret_key);
  err:
   return NULL;
 }
